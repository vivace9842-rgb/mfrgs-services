# Local-only files
node_modules
api/node_modules
package-lock.json
api/package-lock.json
.env
.env.local
.env.production
.vercel

# Vercel deployment boundary
# The current backend is exposed through one Express entrypoint.
# Legacy standalone modules under /api remain versioned in GitHub,
# but must not be deployed as separate Serverless Functions.
api/*
!api/index.ts
