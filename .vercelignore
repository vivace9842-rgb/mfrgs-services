# Local-only files
node_modules
api/node_modules
package-lock.json
api/package-lock.json
.env
.env.local
.env.production
.vercel

# The Express application is the single runtime source of truth.
# Vercel exposes only api/index.ts as the entrypoint.
# All legacy API modules are intentionally excluded from deployment.
api/*
!api/index.ts
