{
  "version": 2,
  "builds": [
    {
      "src": "api/*.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    { "src": "/api/health", "dest": "api/health.js" },
    { "src": "/api/stripe", "dest": "api/stripe.js" },
    { "src": "/api/pdf", "dest": "api/pdf.js" },
    { "src": "/api/report", "dest": "api/report.js" },
    { "src": "/api/verify", "dest": "api/verify.js" }
  ]
}
