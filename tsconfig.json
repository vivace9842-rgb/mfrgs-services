{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "rootDir": ".",
    "outDir": "dist",

    "strict": true,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "resolveJsonModule": true,

    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    "sourceMap": true,

    "noEmit": false
  },

  "include": [
    "src/**/*.ts",
    "api/webhook.ts"
  ],

  "exclude": [
    "node_modules",
    "dist",
    "api/scripts"
  ]
}